// Launcher. Results come from row.blp and, apps in a grid, appcell.blp;
// Go fills `results`, which scrolls.
using Gtk 4.0;

ApplicationWindow launcher {
  styles ["launcher"]

  Box {
    orientation: vertical;
    // Fixed size, so the surface does not resize (and move) with the results.
    width-request: 800;
    height-request: 620;

    // The head reads like a section head: the square mark, the mode as a
    // mono label in brackets, its name, and the key that switches modes.
    Box {
      styles ["head"]
      spacing: 10;

      Box {
        styles ["mark"]
        valign: center;
      }

      Label mode {
        styles ["tag"]
      }

      Label mode_desc {
        styles ["dim"]
        hexpand: true;
        xalign: 0;
      }

      Label {
        styles ["kicker"]
        label:  _("Tab  switch");
      }
    }

    Entry query {
      styles ["query"]
      placeholder-text:  _("Search, or ask: 10 km to mi");
    }

    // The results scroll above a blurred foot, shown under apps: Go fills
    // `blur` with strips, each a copy of the results just below the view,
    // blurred more the lower, under a fade into the window. The web search
    // and the assistant stay in sight below it (`pinned`).
    ScrolledWindow scroll {
      styles ["results-scroll"]
      hscrollbar-policy: never;
      vexpand: true;

      // The selection is one box over the results, gliding from one to
      // the next (Go places it).
      Overlay {
        Box results {
          styles ["results"]
          orientation: vertical;
        }

        [overlay]
        Box highlight {
          styles ["highlight"]
          halign: start;
          valign: start;
          can-target: false;
          visible: false;
        }
      }
    }

    Overlay foot {
      styles ["results-foot"]

      Box blur {
        orientation: vertical;
        can-target: false;
      }

      [overlay]
      Box fade {
        styles ["results-fade"]
        can-target: false;
      }
    }

    Box pinned {
      styles ["pinned"]
      orientation: vertical;
    }

    // Why the list is empty, or what went wrong with the last action. The
    // tag ([ERROR]) shows only for failures.
    Box message_box {
      styles ["notice"]
      spacing: 8;
      visible: false;

      Label message_tag {
        styles ["tag", "error"]
        label:  _("[ERROR]");
      }

      Label message {
        styles ["dim"]
        hexpand: true;
        xalign: 0;
        ellipsize: end;
      }
    }

    Box {
      styles ["foot"]
      spacing: 18;

      Label {
        styles ["kicker"]
        label:  _("↑↓  choose");
      }

      Label {
        styles ["kicker"]
        label:  _("↵  open");
      }

      Label {
        styles ["kicker"]
        label:  _("Esc  close");
      }
    }
  }
}
