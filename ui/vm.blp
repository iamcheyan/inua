// Windows VM manager: first-run recommendation with an advanced path, host
// checks, and the VM's lifecycle buttons. Buttons carry a `name` that Go uses
// to tell them apart (they share one handler).
using Gtk 4.0;

ApplicationWindow vm {
  title: _("Windows VM");
  default-width: 620;
  default-height: 720;

  Box {
    orientation: vertical;
    spacing: 12;
    margin-top: 20;
    margin-bottom: 20;
    margin-start: 20;
    margin-end: 20;

    Label {
      label: _("Windows virtual machine");
      styles ["title-1"]
      halign: start;
    }

    Label vm_status {
      label: _("Not configured");
      halign: start;
      wrap: true;
      xalign: 0;
    }

    Label {
      label: _("Recommended first-run profile");
      styles ["title-3"]
      halign: start;
    }

    Label {
      label: _("A balanced profile keeps enough memory and CPU capacity available for your system.");
      wrap: true;
      xalign: 0;
    }

    Button vm_accept {
      name: "accept";
      label: _("Accept recommended profile");
    }

    Button vm_advanced_toggle {
      name: "advanced_toggle";
      label: _("Advanced configuration");
    }

    Revealer vm_advanced {
      reveal-child: false;

      Box {
        orientation: vertical;
        spacing: 8;

        Label {
          label: _("Memory (MiB)");
          halign: start;
        }

        SpinButton vm_memory {
          adjustment: Adjustment {
            lower: 1024;
            upper: 262144;
            step-increment: 1024;
            page-increment: 4096;
            value: 8192;
          };
          numeric: true;
        }

        Label {
          label: _("CPU cores");
          halign: start;
        }

        SpinButton vm_cpus {
          adjustment: Adjustment {
            lower: 1;
            upper: 256;
            step-increment: 1;
            page-increment: 2;
            value: 4;
          };
          numeric: true;
        }

        Label {
          label: _("Disk size (GiB)");
          halign: start;
        }

        SpinButton vm_disk {
          adjustment: Adjustment {
            lower: 32;
            upper: 2048;
            step-increment: 16;
            page-increment: 64;
            value: 128;
          };
          numeric: true;
        }

        Button vm_configure {
          name: "configure";
          label: _("Save configuration");
        }
      }
    }

    Label {
      label: _("System status and checks");
      styles ["title-3"]
      halign: start;
    }

    Label vm_doctor {
      label: _("No issues reported");
      halign: start;
      wrap: true;
      selectable: true;
      xalign: 0;
    }

    Box {
      spacing: 8;

      Button vm_install {
        name: "install";
        label: _("Download and install Windows");
      }

      Button vm_start {
        name: "start";
        label: _("Start");
      }

      Button vm_connect {
        name: "connect";
        label: _("Connect");
      }
    }

    Box {
      spacing: 8;

      Button vm_console {
        name: "console";
        label: _("Open web console");
      }

      Button vm_stop {
        name: "stop";
        label: _("Stop");
      }

      Button vm_remove {
        name: "remove";
        label: _("Remove VM");
      }
    }

    Box {
      spacing: 8;

      Button vm_remove_data {
        name: "remove_data";
        styles ["destructive-action"]
        label: _("Delete disk data");
        tooltip-text: _("Deletes the Windows disk permanently. Stopping or removing the VM never does.");
      }
    }

    ProgressBar vm_progress {
      show-text: false;
    }

    Label vm_progress_text {
      label: "";
      halign: start;
      wrap: true;
      xalign: 0;
    }
  }
}
