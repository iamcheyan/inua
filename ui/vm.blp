// Windows VM: manages one Windows guest. The window has four pages on a
// hidden stack; Go switches between them as the guest's state changes.
//
//   prereq       — some host requirement is missing; shows what and why
//   setup        — prerequisites are met but nothing is installed yet;
//                  the user picks a profile and starts the installation
//   provisioning — Docker is pulling the image or Windows is installing
//   ready        — the guest is installed; shows start/connect/stop and
//                  lets the user adjust the non-disk resource settings
//
// None of the pages show controls that cannot do anything useful in the
// current state. Go fills the labels and switches the visible page.
using Gtk 4.0;

ApplicationWindow vm {
  styles ["settings", "vmpage"]
  title:  _("Windows VM");
  default-width: 520;
  default-height: 640;

  Box {
    orientation: vertical;

    // ── headline ─────────────────────────────────────────────────────────
    Box {
      styles ["vm-head"]
      spacing: 12;

      Box {
        orientation: vertical;
        hexpand: true;
        valign: center;
        spacing: 2;

        Label {
          styles ["vm-title"]
          label:  _("Windows VM");
          xalign: 0;
        }

        Label vm_sub {
          styles ["sub"]
          xalign: 0;
          ellipsize: end;
        }
      }

      Label vm_mark {
        styles ["mark"]
        valign: center;
      }
    }

    // ── four-page stack ───────────────────────────────────────────────────
    Stack vm_stack {
      vexpand: true;
      transition-type: crossfade;
      transition-duration: 140;

      // ── PAGE: prereq ── one or more host requirements are missing ─────
      StackPage {
        name: "prereq";
        child: ScrolledWindow {
          hscrollbar-policy: never;

          Box {
            orientation: vertical;

            // What is wrong and how to fix it.
            Box vm_prereq_list {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Label {
                  styles ["mark"]
                  valign: center;
                }

                Label {
                  styles ["section-label"]
                  label:  _("[HOST]");
                  hexpand: true;
                  xalign: 0;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;

                // Go appends one .vm-check-row per check.
                Box vm_check_rows {
                  styles ["rows", "vm-check-rows"]
                  orientation: vertical;
                }
              }
            }
          }
        };
      }

      // ── PAGE: setup ── ready to install ────────────────────────────────
      StackPage {
        name: "setup";
        child: ScrolledWindow {
          hscrollbar-policy: never;

          Box {
            orientation: vertical;

            // — profile section —
            Box {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Label {
                  styles ["mark"]
                  valign: center;
                }

                Label {
                  styles ["section-label"]
                  label:  _("[GUEST]");
                  hexpand: true;
                  xalign: 0;
                }

                Label vm_setup_summary {
                  styles ["section-meta"]
                  xalign: 1;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;

                // Recommended profile row
                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Recommended profile");
                      xalign: 0;
                    }

                    Label vm_profile_desc {
                      styles ["sub"]
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Button vm_accept {
                    styles ["outlined"]
                    name: "accept";
                    label:  _("Use it");
                    valign: center;
                  }
                }

                // Advanced editor (collapsed)
                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Advanced configuration");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Set memory, CPU cores and disk size yourself.");
                      xalign: 0;
                    }
                  }

                  Button vm_advanced_toggle {
                    styles ["outlined"]
                    name: "advanced_toggle";
                    label:  _("Edit");
                    valign: center;
                  }
                }

                Revealer vm_advanced {
                  reveal-child: false;
                  transition-type: slide_down;
                  transition-duration: 180;

                  Box {
                    orientation: vertical;

                    Box {
                      styles ["field"]

                      Label {
                        styles ["label"]
                        label:  _("Memory (MiB)");
                        hexpand: true;
                        xalign: 0;
                        valign: center;
                      }

                      SpinButton vm_memory {
                        adjustment: Adjustment {
                          lower: 2048;
                          upper: 262144;
                          step-increment: 1024;
                          page-increment: 4096;
                          value: 8192;
                        };
                        numeric: true;
                        valign: center;
                      }
                    }

                    Box {
                      styles ["field"]

                      Label {
                        styles ["label"]
                        label:  _("CPU cores");
                        hexpand: true;
                        xalign: 0;
                        valign: center;
                      }

                      SpinButton vm_cpus {
                        adjustment: Adjustment {
                          lower: 1;
                          upper: 256;
                          step-increment: 1;
                          page-increment: 2;
                          value: 4;
                        };
                        numeric: true;
                        valign: center;
                      }
                    }

                    Box {
                      styles ["field"]

                      Label {
                        styles ["label"]
                        label:  _("Disk size (GiB)");
                        hexpand: true;
                        xalign: 0;
                        valign: center;
                      }

                      SpinButton vm_disk {
                        adjustment: Adjustment {
                          lower: 32;
                          upper: 2048;
                          step-increment: 16;
                          page-increment: 64;
                          value: 128;
                        };
                        numeric: true;
                        valign: center;
                      }
                    }

                    Box {
                      styles ["row"]
                      halign: end;

                      Button vm_configure {
                        styles ["outlined"]
                        name: "configure";
                        label:  _("Save profile");
                        valign: center;
                      }
                    }
                  }
                }
              }
            }

            // — install section —
            Box {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Label {
                  styles ["mark"]
                  valign: center;
                }

                Label {
                  styles ["section-label"]
                  label:  _("[INSTALL]");
                  hexpand: true;
                  xalign: 0;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Download and install Windows");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Downloads about 8 GB and installs Windows; takes 30+ minutes.");
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Button vm_install {
                    styles ["outlined"]
                    name: "install";
                    label:  _("Install");
                    valign: center;
                  }
                }
              }
            }
          }
        };
      }

      // ── PAGE: provisioning ── downloading / first-time install ────────
      StackPage {
        name: "provisioning";
        child: Box {
          orientation: vertical;

          Box {
            styles ["section"]
            orientation: vertical;

            Box {
              styles ["section-head"]
              spacing: 10;

              Label {
                styles ["mark"]
                valign: center;
              }

              Label {
                styles ["section-label"]
                label:  _("[PROGRESS]");
                hexpand: true;
                xalign: 0;
              }
            }

            Box {
              styles ["section-body"]
              orientation: vertical;

              Box {
                styles ["row"]
                orientation: vertical;
                spacing: 10;

                ProgressBar vm_progress {
                  show-text: false;
                }

                Label vm_progress_text {
                  styles ["sub"]
                  xalign: 0;
                  wrap: true;
                }
              }

              Box {
                styles ["row"]

                Box {
                  orientation: vertical;
                  hexpand: true;
                  valign: center;
                  spacing: 2;

                  Label {
                    styles ["label"]
                    label:  _("Watch the installation");
                    xalign: 0;
                  }

                  Label {
                    styles ["sub"]
                    label:  _("The installer screen is in your browser.");
                    xalign: 0;
                  }
                }

                Button vm_console {
                  styles ["outlined"]
                  name: "console";
                  label:  _("Open web console");
                  valign: center;
                }
              }

              Box {
                styles ["row"]

                Box {
                  orientation: vertical;
                  hexpand: true;
                  valign: center;
                  spacing: 2;

                  Label {
                    styles ["label"]
                    label:  _("Stop waiting");
                    xalign: 0;
                  }

                  Label {
                    styles ["sub"]
                    label:  _("Stops the container; the disk is kept. Reopen to resume.");
                    xalign: 0;
                    wrap: true;
                  }
                }

                Button vm_prov_stop {
                  styles ["outlined"]
                  name: "prov_stop";
                  label:  _("Stop");
                  valign: center;
                }
              }
            }
          }
        };
      }

      // ── PAGE: ready ── guest is installed ─────────────────────────────
      StackPage {
        name: "ready";
        child: ScrolledWindow {
          hscrollbar-policy: never;

          Box {
            orientation: vertical;

            // — config section (partial edit after install) —
            Box {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Label {
                  styles ["mark"]
                  valign: center;
                }

                Label {
                  styles ["section-label"]
                  label:  _("[GUEST]");
                  hexpand: true;
                  xalign: 0;
                }

                Label vm_ready_summary {
                  styles ["section-meta"]
                  xalign: 1;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;

                Box {
                  styles ["field"]

                  Label {
                    styles ["label"]
                    label:  _("Memory (MiB)");
                    hexpand: true;
                    xalign: 0;
                    valign: center;
                  }

                  Box {
                    orientation: vertical;
                    valign: center;
                    spacing: 2;

                    SpinButton vm_ready_memory {
                      adjustment: Adjustment {
                        lower: 2048;
                        upper: 262144;
                        step-increment: 1024;
                        page-increment: 4096;
                        value: 8192;
                      };
                      numeric: true;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Takes effect on next start.");
                      xalign: 1;
                    }
                  }
                }

                Box {
                  styles ["field"]

                  Label {
                    styles ["label"]
                    label:  _("CPU cores");
                    hexpand: true;
                    xalign: 0;
                    valign: center;
                  }

                  Box {
                    orientation: vertical;
                    valign: center;
                    spacing: 2;

                    SpinButton vm_ready_cpus {
                      adjustment: Adjustment {
                        lower: 1;
                        upper: 256;
                        step-increment: 1;
                        page-increment: 2;
                        value: 4;
                      };
                      numeric: true;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Takes effect on next start.");
                      xalign: 1;
                    }
                  }
                }

                Box {
                  styles ["field"]

                  Label {
                    styles ["label"]
                    label:  _("Disk size (GiB)");
                    hexpand: true;
                    xalign: 0;
                    valign: center;
                  }

                  Box {
                    orientation: vertical;
                    valign: center;
                    spacing: 2;

                    Label vm_disk_size {
                      styles ["readout"]
                      xalign: 1;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Enlarging needs a manual partition resize inside Windows.");
                      xalign: 1;
                      wrap: true;
                    }
                  }
                }

                Box {
                  styles ["row"]
                  halign: end;

                  Button vm_ready_save {
                    styles ["outlined"]
                    name: "ready_save";
                    label:  _("Apply");
                    valign: center;
                  }
                }
              }
            }

            // — actions section —
            Box {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Label {
                  styles ["mark"]
                  valign: center;
                }

                Label {
                  styles ["section-label"]
                  label:  _("[ACTIONS]");
                  hexpand: true;
                  xalign: 0;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;

                // Start (when stopped)
                Box vm_row_start {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Start");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Starts the guest; ready in a minute or two.");
                      xalign: 0;
                    }
                  }

                  Button vm_start {
                    styles ["outlined"]
                    name: "start";
                    label:  _("Start");
                    valign: center;
                  }
                }

                // Connect + console (when running)
                Box vm_row_connect {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Connect");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Opens FreeRDP.");
                      xalign: 0;
                    }
                  }

                  Box {
                    spacing: 8;

                    Button vm_console_ready {
                      styles ["outlined"]
                      name: "console_ready";
                      label:  _("Web console");
                      valign: center;
                    }

                    Button vm_connect {
                      styles ["outlined"]
                      name: "connect";
                      label:  _("Connect");
                      valign: center;
                    }
                  }
                }

                // Stop (when running)
                Box vm_row_stop {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Stop");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Stops the guest; the disk is kept.");
                      xalign: 0;
                    }
                  }

                  Button vm_stop {
                    styles ["outlined"]
                    name: "stop";
                    label:  _("Stop");
                    valign: center;
                  }
                }
              }
            }

            // — destructive actions (separator then two confirmed rows) —
            Box {
              styles ["section"]
              orientation: vertical;

              Box {
                styles ["section-head"]
                spacing: 10;

                Label {
                  styles ["mark"]
                  valign: center;
                }

                Label {
                  styles ["section-label"]
                  label:  _("[REMOVE]");
                  hexpand: true;
                  xalign: 0;
                }
              }

              Box {
                styles ["section-body"]
                orientation: vertical;

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Remove VM");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Deletes the container, project and password. The disk stays.");
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Button vm_remove {
                    styles ["outlined"]
                    name: "remove";
                    label:  _("Remove");
                    valign: center;
                  }
                }

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["label"]
                      label:  _("Delete disk data");
                      xalign: 0;
                    }

                    Label {
                      styles ["sub"]
                      label:  _("Permanently deletes the Windows disk. Cannot be undone.");
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Button vm_remove_data {
                    styles ["destructive-action"]
                    name: "remove_data";
                    label:  _("Delete");
                    valign: center;
                  }
                }
              }
            }
          }
        };
      }
    }
  }
}
