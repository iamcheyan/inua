// Windows VM: the shell's manager for one Windows guest. A header says what
// the guest is doing; below it, sections of rows - the guest's resources (a
// recommended profile, and the advanced editor behind it), the host checks,
// and the lifecycle. Go fills the state, the doctor lines and the summary
// (internal/ui/vm.go, vm_service.go).
using Gtk 4.0;

ApplicationWindow vm {
  styles ["settings", "vmpage"]
  title:  _("Windows VM");
  default-width: 520;
  default-height: 720;

  Box {
    orientation: vertical;

    Box {
      styles ["header"]
      spacing: 12;

      Box {
        orientation: vertical;
        hexpand: true;
        valign: center;
        spacing: 2;

        Label {
          styles ["title"]
          label:  _("Windows VM");
          xalign: 0;
        }

        Label state_sub {
          styles ["sub"]
          xalign: 0;
          ellipsize: end;
        }
      }

      Label state_mark {
        styles ["mark"]
        valign: center;
      }
    }

    // What the guest is doing, or why it cannot be used yet.
    Label notice {
      styles ["vnotice"]
      visible: false;
      xalign: 0;
      wrap: true;
    }

    ScrolledWindow {
      vexpand: true;
      hscrollbar-policy: never;

      Box {
        orientation: vertical;

        // --- the guest's resources ---
        Box {
          styles ["section"]
          orientation: vertical;

          Box guest_head {
            styles ["section-head"]
            spacing: 10;

            Label {
              styles ["mark"]
              valign: center;
            }

            Label {
              styles ["section-label"]
              label:  _("[GUEST]");
              hexpand: true;
              xalign: 0;
            }

            Label profile_summary {
              styles ["section-meta"]
              xalign: 1;
            }
          }

          Box {
            styles ["section-body"]
            orientation: vertical;

            Box row_profile {
              styles ["row"]

              Box {
                orientation: vertical;
                hexpand: true;
                valign: center;
                spacing: 2;

                Label {
                  styles ["label"]
                  label:  _("Recommended profile");
                  xalign: 0;
                }

                Label {
                  styles ["sub"]
                  label:  _("A balanced profile leaves memory and CPU for your system.");
                  xalign: 0;
                  wrap: true;
                }
              }

              Button accept {
                styles ["outlined"]
                name: "accept";
                label:  _("Use it");
                valign: center;
              }
            }

            Box row_advanced {
              styles ["row"]

              Box {
                orientation: vertical;
                hexpand: true;
                valign: center;
                spacing: 2;

                Label {
                  styles ["label"]
                  label:  _("Advanced configuration");
                  xalign: 0;
                }

                Label {
                  styles ["sub"]
                  label:  _("Set the memory, CPU cores and disk size yourself.");
                  xalign: 0;
                  wrap: true;
                }
              }

              Button advanced_toggle {
                styles ["outlined"]
                name: "advanced_toggle";
                label:  _("Edit");
                valign: center;
              }
            }

            Revealer advanced {
              reveal-child: false;
              transition-type: slide_down;
              transition-duration: 180;

              Box {
                styles ["section-body", "fields"]
                orientation: vertical;

                Box field_memory {
                  styles ["field"]

                  Label {
                    styles ["label"]
                    label:  _("Memory (MiB)");
                    hexpand: true;
                    xalign: 0;
                    valign: center;
                  }

                  SpinButton memory {
                    name: "memory";
                    adjustment: Adjustment {
                      lower: 1024;
                      upper: 262144;
                      step-increment: 1024;
                      page-increment: 4096;
                      value: 8192;
                    };
                    numeric: true;
                    valign: center;
                  }
                }

                Box field_cpus {
                  styles ["field"]

                  Label {
                    styles ["label"]
                    label:  _("CPU cores");
                    hexpand: true;
                    xalign: 0;
                    valign: center;
                  }

                  SpinButton cpus {
                    name: "cpus";
                    adjustment: Adjustment {
                      lower: 1;
                      upper: 256;
                      step-increment: 1;
                      page-increment: 2;
                      value: 4;
                    };
                    numeric: true;
                    valign: center;
                  }
                }

                Box field_disk {
                  styles ["field"]

                  Label {
                    styles ["label"]
                    label:  _("Disk size (GiB)");
                    hexpand: true;
                    xalign: 0;
                    valign: center;
                  }

                  SpinButton disk {
                    name: "disk";
                    adjustment: Adjustment {
                      lower: 32;
                      upper: 2048;
                      step-increment: 16;
                      page-increment: 64;
                      value: 128;
                    };
                    numeric: true;
                    valign: center;
                  }
                }

                Box {
                  styles ["row"]

                  Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;
                    spacing: 2;

                    Label {
                      styles ["sub"]
                      label:  _("Saving writes the guest's project without starting it.");
                      xalign: 0;
                      wrap: true;
                    }
                  }

                  Button configure {
                    styles ["outlined"]
                    name: "configure";
                    label:  _("Save");
                    valign: center;
                  }
                }
              }
            }
          }
        }

        // --- the host checks ---
        Box {
          styles ["section"]
          orientation: vertical;

          Box host_head {
            styles ["section-head"]
            spacing: 10;

            Label {
              styles ["mark"]
              valign: center;
            }

            Label {
              styles ["section-label"]
              label:  _("[HOST]");
              hexpand: true;
              xalign: 0;
            }
          }

          Box {
            styles ["section-body"]
            orientation: vertical;

            Box {
              styles ["row"]

              Box {
                orientation: vertical;
                hexpand: true;
                spacing: 2;

                Label doctor {
                  styles ["label"]
                  label: "—";
                  xalign: 0;
                  wrap: true;
                  selectable: true;
                }
              }
            }
          }
        }

        // --- the lifecycle ---
        Box {
          styles ["section"]
          orientation: vertical;

          Box actions_head {
            styles ["section-head"]
            spacing: 10;

            Label {
              styles ["mark"]
              valign: center;
            }

            Label {
              styles ["section-label"]
              label:  _("[ACTIONS]");
              hexpand: true;
              xalign: 0;
            }
          }

          Box {
            styles ["section-body"]
            orientation: vertical;

            Box row_install {
              styles ["row"]

              Box {
                orientation: vertical;
                hexpand: true;
                valign: center;
                spacing: 2;

                Label {
                  styles ["label"]
                  label:  _("Download and install");
                  xalign: 0;
                }

                Label {
                  styles ["sub"]
                  label:  _("Downloads the image and installs Windows; it takes a while.");
                  xalign: 0;
                  wrap: true;
                }
              }

              Button install {
                styles ["outlined"]
                name: "install";
                label:  _("Install");
                valign: center;
              }
            }

            Box row_run {
              styles ["row"]

              Box {
                orientation: vertical;
                hexpand: true;
                valign: center;
                spacing: 2;

                Label {
                  styles ["label"]
                  label:  _("Start and connect");
                  xalign: 0;
                }

                Label {
                  styles ["sub"]
                  label:  _("Connect opens FreeRDP once Windows is ready.");
                  xalign: 0;
                  wrap: true;
                }
              }

              Box {
                spacing: 8;

                Button start {
                  styles ["outlined"]
                  name: "start";
                  label:  _("Start");
                  valign: center;
                }

                Button connect {
                  styles ["outlined"]
                  name: "connect";
                  label:  _("Connect");
                  valign: center;
                }
              }
            }

            Box row_console {
              styles ["row"]

              Box {
                orientation: vertical;
                hexpand: true;
                valign: center;
                spacing: 2;

                Label {
                  styles ["label"]
                  label:  _("Web console");
                  xalign: 0;
                }

                Label {
                  styles ["sub"]
                  label:  _("The installer's screen, in your browser.");
                  xalign: 0;
                  wrap: true;
                }
              }

              Button console {
                styles ["outlined"]
                name: "console";
                label:  _("Open");
                valign: center;
              }
            }

            Box row_stop {
              styles ["row"]

              Box {
                orientation: vertical;
                hexpand: true;
                valign: center;
                spacing: 2;

                Label {
                  styles ["label"]
                  label:  _("Stop");
                  xalign: 0;
                }

                Label {
                  styles ["sub"]
                  label:  _("Stops the guest and keeps its disk.");
                  xalign: 0;
                  wrap: true;
                }
              }

              Button stop {
                styles ["outlined"]
                name: "stop";
                label:  _("Stop");
                valign: center;
              }
            }

            Box row_remove {
              styles ["row"]

              Box {
                orientation: vertical;
                hexpand: true;
                valign: center;
                spacing: 2;

                Label {
                  styles ["label"]
                  label:  _("Remove VM");
                  xalign: 0;
                }

                Label {
                  styles ["sub"]
                  label:  _("Deletes the container, project and password; the disk stays.");
                  xalign: 0;
                  wrap: true;
                }
              }

              Button remove {
                styles ["outlined"]
                name: "remove";
                label:  _("Remove");
                valign: center;
              }
            }

            Box row_remove_data {
              styles ["row"]

              Box {
                orientation: vertical;
                hexpand: true;
                valign: center;
                spacing: 2;

                Label {
                  styles ["label"]
                  label:  _("Delete disk data");
                  xalign: 0;
                }

                Label {
                  styles ["sub"]
                  label:  _("Deletes the Windows disk for good; stopping never does.");
                  xalign: 0;
                  wrap: true;
                }
              }

              Button remove_data {
                styles ["destructive-action"]
                name: "remove_data";
                label:  _("Delete");
                valign: center;
              }
            }
          }
        }

        // Progress, while a lifecycle action runs.
        Box {
          styles ["vprogress"]

          ProgressBar progress {
            vexpand: true;
          }

          Label progress_text {
            styles ["readout"]
            xalign: 0;
            wrap: true;
          }
        }
      }
    }
  }
}
