                                                <property name="step-increment">1</property>
                                                <property name="page-increment">2</property>
                                                <property name="value">4</property>
                                              </object>
                                            </property>
                                            <property name="numeric">true</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="sub"/>
                                            </style>
                                            <property name="label" translatable="yes">Takes effect on next start.</property>
                                            <property name="xalign">1</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="field"/>
                                    </style>
                                    <child>
                                      <object class="GtkLabel">
                                        <style>
                                          <class name="label"/>
                                        </style>
                                        <property name="label" translatable="yes">Disk size (GiB)</property>
                                        <property name="hexpand">true</property>
                                        <property name="xalign">0</property>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="valign">3</property>
                                        <property name="spacing">2</property>
                                        <child>
                                          <object class="GtkLabel" id="vm_disk_size">
                                            <style>
                                              <class name="readout"/>
                                            </style>
                                            <property name="xalign">1</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="sub"/>
                                            </style>
                                            <property name="label" translatable="yes">Enlarging needs a manual partition resize inside Windows.</property>
                                            <property name="xalign">1</property>
                                            <property name="wrap">true</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="row"/>
                                    </style>
                                    <property name="halign">2</property>
                                    <child>
                                      <object class="GtkButton" id="vm_ready_save">
                                        <style>
                                          <class name="outlined"/>
                                        </style>
                                        <property name="name">ready_save</property>
                                        <property name="label" translatable="yes">Apply</property>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="section"/>
                            </style>
                            <property name="orientation">1</property>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section-head"/>
                                </style>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="mark"/>
                                    </style>
                                    <property name="valign">3</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="section-label"/>
                                    </style>
                                    <property name="label" translatable="yes">[ACTIONS]</property>
                                    <property name="hexpand">true</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section-body"/>
                                </style>
                                <property name="orientation">1</property>
                                <child>
                                  <object class="GtkBox" id="vm_row_start">
                                    <style>
                                      <class name="row"/>
                                    </style>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="hexpand">true</property>
                                        <property name="valign">3</property>
                                        <property name="spacing">2</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="label"/>
                                            </style>
                                            <property name="label" translatable="yes">Start</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="sub"/>
                                            </style>
                                            <property name="label" translatable="yes">Starts the guest; ready in a minute or two.</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="vm_start">
                                        <style>
                                          <class name="outlined"/>
                                        </style>
                                        <property name="name">start</property>
                                        <property name="label" translatable="yes">Start</property>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="vm_row_connect">
                                    <style>
                                      <class name="row"/>
                                    </style>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="hexpand">true</property>
                                        <property name="valign">3</property>
                                        <property name="spacing">2</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="label"/>
                                            </style>
                                            <property name="label" translatable="yes">Connect</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="sub"/>
                                            </style>
                                            <property name="label" translatable="yes">Opens FreeRDP.</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="spacing">8</property>
                                        <child>
                                          <object class="GtkButton" id="vm_console_ready">
                                            <style>
                                              <class name="outlined"/>
                                            </style>
                                            <property name="name">console_ready</property>
                                            <property name="label" translatable="yes">Web console</property>
                                            <property name="valign">3</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="vm_connect">
                                            <style>
                                              <class name="outlined"/>
                                            </style>
                                            <property name="name">connect</property>
                                            <property name="label" translatable="yes">Connect</property>
                                            <property name="valign">3</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="vm_row_stop">
                                    <style>
                                      <class name="row"/>
                                    </style>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="hexpand">true</property>
                                        <property name="valign">3</property>
                                        <property name="spacing">2</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="label"/>
                                            </style>
                                            <property name="label" translatable="yes">Stop</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="sub"/>
                                            </style>
                                            <property name="label" translatable="yes">Stops the guest; the disk is kept.</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="vm_stop">
                                        <style>
                                          <class name="outlined"/>
                                        </style>
                                        <property name="name">stop</property>
                                        <property name="label" translatable="yes">Stop</property>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <style>
                              <class name="section"/>
                            </style>
                            <property name="orientation">1</property>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section-head"/>
                                </style>
                                <property name="spacing">10</property>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="mark"/>
                                    </style>
                                    <property name="valign">3</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <style>
                                      <class name="section-label"/>
                                    </style>
                                    <property name="label" translatable="yes">[REMOVE]</property>
                                    <property name="hexpand">true</property>
                                    <property name="xalign">0</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <style>
                                  <class name="section-body"/>
                                </style>
                                <property name="orientation">1</property>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="row"/>
                                    </style>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="hexpand">true</property>
                                        <property name="valign">3</property>
                                        <property name="spacing">2</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="label"/>
                                            </style>
                                            <property name="label" translatable="yes">Remove VM</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="sub"/>
                                            </style>
                                            <property name="label" translatable="yes">Deletes the container, project and password. The disk stays.</property>
                                            <property name="xalign">0</property>
                                            <property name="wrap">true</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="vm_remove">
                                        <style>
                                          <class name="outlined"/>
                                        </style>
                                        <property name="name">remove</property>
                                        <property name="label" translatable="yes">Remove</property>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <style>
                                      <class name="row"/>
                                    </style>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="hexpand">true</property>
                                        <property name="valign">3</property>
                                        <property name="spacing">2</property>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="label"/>
                                            </style>
                                            <property name="label" translatable="yes">Delete disk data</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel">
                                            <style>
                                              <class name="sub"/>
                                            </style>
                                            <property name="label" translatable="yes">Permanently deletes the Windows disk. Cannot be undone.</property>
                                            <property name="xalign">0</property>
                                            <property name="wrap">true</property>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkButton" id="vm_remove_data">
                                        <style>
                                          <class name="destructive-action"/>
                                        </style>
                                        <property name="name">remove_data</property>
                                        <property name="label" translatable="yes">Delete</property>
                                        <property name="valign">3</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>