// The widget page, the place before the first workspace: the bar's mark,
// the wheel up past the first workspace, a four-finger swipe or the
// shortcut opens it, and it slides in from the left over the windows,
// between the bar and the dock. Escape, a workspace, the wheel down or a
// swipe left goes back. Go fills the cards, in widgets.items' order.
using Gtk 4.0;

ApplicationWindow widgets {
  styles ["widgets"]

  Revealer reveal {
    transition-type: slide_right;
    transition-duration: 260;
    hexpand: true;
    vexpand: true;

    Box page {
      styles ["widget-page"]
      orientation: vertical;
      spacing: 18;

      Box {
        styles ["widget-page-head"]
        spacing: 10;

        Box {
          styles ["mark"]
          valign: center;
        }

        Label {
          styles ["tag"]
          label: _("[WIDGETS]");
        }

        Label {
          styles ["readout", "widget-page-hint"]
          hexpand: true;
          xalign: 0;
          ellipsize: end;
          label: _("Drag a head to move it · Right-click to remove · Esc · back");
        }

        MenuButton add {
          styles ["link"]
          label: _("Add widget");
          valign: center;
        }
      }

      ScrolledWindow {
        vexpand: true;
        hscrollbar-policy: never;

        FlowBox cards {
          styles ["widget-cards"]
          selection-mode: none;
          homogeneous: false;
          column-spacing: 18;
          row-spacing: 18;
          min-children-per-line: 1;
          max-children-per-line: 4;
          valign: start;
          halign: start;
        }
      }
    }
  }
}
